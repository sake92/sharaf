  new CreateCrossModules {
    root = "formson"
    template = (baseTemplate) {
      pomSettings {
        artifactId = "formson"
        name = "Formson"
        description = "Sharaf form binding library"
      }
      deps { "com.lihaoyi::fastparse::\(versions.fastparse)" }
