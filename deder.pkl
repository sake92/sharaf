    }
  }.get

local const exampleModules = new Examples.Examples {
  libraryTemplate = baseTemplate
  dependencyVersions = versions
  undertow = sharafUndertowModules.main
  pac4j = sharafPac4jModules.main
  jdkHttpserver = sharafJdkHttpserverModules.jvm
  snunit = sharafSnunit
  http4s = sharafHttp4sModules.jvm
  potateh = sharafPotatehModules.native
}.all

modules {
  ...validsonModules.all
  ...quersonModules.all
  formsonModules.jvm
  formsonModules.jvm_test
  // java.nio.Path not supported in Scala.js
  formsonModules.native
  formsonModules.native_test
  sharafHepekComponents
  sharafCoreModules.jvm
  sharafCoreModules.jvm_test
  sharafCoreModules.native
  sharafCoreModules.native_test
  sharafJdbcSessionModules.jvm
  sharafJdbcSessionModules.jvm_test
  sharafJdbcSessionModules.native
  sharafJdbcSessionModules.native_test
  ...sharafUndertowModules.all
  sharafHttp4sModules.jvm
  sharafHttp4sModules.jvm_test
  sharafHttp4sModules.native
  sharafHttp4sModules.native_test
  ...sharafHelidonModules.all
  sharafJdkHttpserverModules.jvm
  sharafJdkHttpserverModules.jvm_test
  sharafJdkHttpserverModules.native
  sharafJdkHttpserverModules.native_test
  ...sharafPac4jModules.all
  sharafSnunit
  sharafPotatehModules.jvm
  sharafPotatehModules.jvm_test
  sharafPotatehModules.native
  sharafPotatehModules.native_test
  ...exampleModules
}
