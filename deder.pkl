local const sharafCoreTemplate = (baseTemplate) {
  pomSettings {
    artifactId = "sharaf-core"
    name = "Sharaf Core"
    description = "Core library for Sharaf"
  }
  deps {
    "ba.sake::tupson::\(versions.tupson)"
    "com.lihaoyi::geny::1.1.1"
    "com.softwaremill.sttp.client4::core::\(versions.sttp)"
  }
}
local const sharafCoreModules =
  new CreateCrossModules {
    root = "sharaf-core"
    template = (sharafCoreTemplate) {
      moduleDeps {
        validsonModules.jvm
        quersonModules.jvm
        formsonModules.jvm
      }
      deps {
        "org.playframework.twirl::twirl-api:\(versions.twirl)"
      }
      publish = true
    }
    testTemplate = (sharafCoreTemplate.asTest()) {
      deps { "org.scalameta::munit::\(versions.munit)" }
    }
    nativeTemplate = (sharafCoreTemplate.asNative()) {
      scalaNativeVersion = versions.scalaNativeVersion
      moduleDeps {
        validsonModules.native
        quersonModules.native
        formsonModules.native
      }
      publish = true
    }
    nativeTestTemplate = (nativeTemplate.asTest()) {
      deps { "org.scalameta::munit::\(versions.munit)" }
    }
  }.get

local const sharafJdbcSessionModules =
  new CreateCrossModules {
    root = "sharaf-jdbc-session"
    template = (baseTemplate) {
      pomSettings {
        artifactId = "sharaf-jdbc-session"
        name = "Sharaf JDBC Session"
        description = "JDBC-backed session storage for Sharaf"
      }
      moduleDeps {
        sharafCoreModules.jvm
      }
      deps {
        "ba.sake::squery::0.12.0"
      }
      publish = true
    }
    testTemplate = (baseTemplate.asTest()) {
      moduleDeps {
        sharafCoreModules.jvm_test
      }
      deps {
        "org.scalameta::munit::\(versions.munit)"
        "com.h2database:h2:2.3.232"
      }
    }
    nativeTemplate = (template.asNative()) {
      scalaNativeVersion = versions.scalaNativeVersion
      moduleDeps = new { sharafCoreModules.native }
      publish = true
    }
    nativeTestTemplate = (nativeTemplate.asTest()) {
      deps {
        "org.scalameta::munit::\(versions.munit)"
        "com.github.lolgab::scala-native-jdbc-sqlite::0.0.6"
      }
    }
  }.get

local const sharafHepekComponents = (baseTemplate) {
  id = "sharaf-hepek-components"
  root = "sharaf-hepek-components"
  pomSettings {
    artifactId = "sharaf-hepek-components"
    name = "Sharaf Hepek Components"
    description = "Sharaf integration with hepek-components"
  }
  moduleDeps {
    sharafCoreModules.jvm
  }
  deps { "ba.sake::hepek-components:0.34.0" }
  publish = true
}

local const sharafUndertowModules =
  new CreateScalaModules {
    root = "sharaf-undertow"
    template = (baseTemplate) {
      pomSettings {
        artifactId = "sharaf-undertow"
        name = "Sharaf Undertow"
        description = "Sharaf integration with Undertow"
      }
      moduleDeps {
        sharafCoreModules.jvm
      }
      deps {
        "io.undertow:undertow-core:\(versions.undertow)"
        "ba.sake::tupson-config:\(versions.tupson)"
      }
      publish = true
    }
    testTemplate = (baseTemplate.asTest()) {
      moduleDeps {
        sharafCoreModules.jvm_test
      }
      deps {
        "org.scalameta::munit::\(versions.munit)"
        "org.webjars:jquery:\(versions.jquery)"
      }
    }
  }.get

local const sharafPac4jModules =
  new CreateScalaModules {
    root = "sharaf-pac4j"
    template = (baseTemplate) {
      pomSettings {
        artifactId = "sharaf-pac4j"
        name = "Sharaf Pac4j"
        description = "Sharaf integration with Pac4j security"
      }
      moduleDeps {
        sharafCoreModules.jvm
      }
      deps {
        "org.pac4j:pac4j-core:\(versions.pac4j)"
      }
      publish = true
    }
    testTemplate = (baseTemplate.asTest()) {
      moduleDeps {
        sharafCoreModules.jvm_test
        sharafJdkHttpserverModules.main
      }
      deps {
        "org.scalameta::munit::\(versions.munit)"
        "org.pac4j:pac4j-http:\(versions.pac4j)"
        "org.pac4j:pac4j-oidc:\(versions.pac4j)"
        "no.nav.security:mock-oauth2-server:\(versions.mockOauth2Server)"
        "ba.sake:pac4j-testkit:0.2.0"
      }
    }
  }.get

local const sharafHttp4sModules =
  new CreateCrossModules {
    root = "sharaf-http4s"
    template = (baseTemplate) {
      pomSettings {
        artifactId = "sharaf-http4s"
        name = "Sharaf Http4s"
        description = "Sharaf integration with Http4s"
      }
      moduleDeps { sharafCoreModules.jvm }
      deps { "org.http4s::http4s-server::\(versions.http4s)" }
      publish = true
    }
    testTemplate = (baseTemplate.asTest()) {
      deps {
        "org.scalameta::munit::\(versions.munit)"
        "org.http4s::http4s-client::\(versions.http4s)"
      }
    }
    nativeTemplate = (template.asNative()) {
      scalaNativeVersion = versions.scalaNativeVersion
      moduleDeps = new { sharafCoreModules.native }
      deps {
        "org.http4s::http4s-server::\(versions.http4s)"
        "com.lihaoyi::sourcecode::\(versions.sourcecode)"
        "io.github.cquiroz::scala-java-time::\(versions.scalaJavaTime)"
      }
      publish = true
    }
    nativeTestTemplate = (nativeTemplate.asTest()) {
      multithreading = true
      deps {
        "org.scalameta::munit::\(versions.munit)"
        "org.http4s::http4s-client::\(versions.http4s)"
      }
    }
  }.get

local const sharafHelidonModules =
  new CreateScalaModules {
    root = "sharaf-helidon"
    template = (baseTemplate) {
      pomSettings {
