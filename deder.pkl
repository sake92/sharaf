amends "https://sake92.github.io/deder/config/v0.22.2/DederProject.pkl"

import
  "https://sake92.github.io/deder-plugins/config/deder-web-dashboard/v0.6.0/WebDashboardPlugin.pkl"
  as WD

import "examples.pkl" as Examples

local const versions = new {
  scala = "3.9.0"
  scalaJs = "1.22.0"
  scalaNative = "0.5.12"
  fastparse = "3.1.1"
  sourcecode = "0.4.4"
  scalaJavaTime = "2.7.0"
  munit = "1.3.6"
  tupson = "0.31.0"
  potateh = "0.2.1-SNAPSHOT"
  sttp = "4.0.27"
  twirl = "2.1.0-M9"
  undertow = "2.4.3.Final"
  pac4j = "6.5.8"
  http4s = "1.0.0-M48"
  helidon = "4.5.5"
  logback = "1.6.4"
  mockOauth2Server = "6.0.3"
  jquery = "4.0.0"
}

plugins {
  new WD.WebDashboardPlugin {
    version = "0.6.0"
  }
}

repositories {
  new MavenRepository { url = "https://central.sonatype.com/repository/maven-snapshots/" }
}

local const publishRepo = if (read?("env:DEDER_PUBLISH_SNAPSHOT") == "true")
  new SonatypeSnapshotRepo { id = "sonatype" }
else
  new SonatypeCentralRepo { id = "sonatype" }

local const baseTemplate: ScalaModule = new {
  scalaVersion = versions.scala
  publishTo = publishRepo
  scalacOptions = new Listing<String> {
    "-Yretain-trees" // needed for default parameters
    "-deprecation"
    "-Wunused:all"
    "-explain"
  }
  pomSettings = new {
    artifactId = "dummy"
    name = "dummy"
    groupId = "ba.sake"
    url = "https://github.com/sake92/sharaf"
    licenses {
      new PomLicense {
        name = "Apache License 2.0"
        url = "https://opensource.org/license/apache-2-0"
      }
    }
    developers {
      new PomDeveloper {
        id = "sake92"
        name = "Sakib Hadžiavdić"
        email = "sakib@sake.ba"
      }
    }
    scm {
      url = "https://github.com/sake92/sharaf"
      connection = "scm:git@github.com:sake92/sharaf.git"
    }
  }
}

local const validsonModules =
  new CreateCrossModules {
    root = "validson"
    template = (baseTemplate) {
      pomSettings {
        artifactId = "validson"
        name = "Validson"
        description = "Sharaf validation library"
      }
      deps { "com.lihaoyi::sourcecode::\(versions.sourcecode)" }
      publish = true
    }
    testTemplate = (baseTemplate.asTest()) {
      deps { "org.scalameta::munit::\(versions.munit)" }
    }
    jsTemplate = (template.asJs()) {
      scalaJsVersion = versions.scalaJs
      deps {
        "com.lihaoyi::sourcecode::\(versions.sourcecode)"
        "io.github.cquiroz::scala-java-time::\(versions.scalaJavaTime)"
      }
      publish = true
    }
    jsTestTemplate = (jsTemplate.asTest()) {
      deps { "org.scalameta::munit::\(versions.munit)" }
    }
    nativeTemplate = (template.asNative()) {
      scalaNativeVersion = versions.scalaNative
      deps {
        "com.lihaoyi::sourcecode::\(versions.sourcecode)"
        "io.github.cquiroz::scala-java-time::\(versions.scalaJavaTime)"
      }
      publish = true
    }
    nativeTestTemplate = (nativeTemplate.asTest()) {
      deps { "org.scalameta::munit::\(versions.munit)" }
    }
  }.get

